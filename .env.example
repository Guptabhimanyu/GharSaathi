# Set any of these (more = more fallback capacity). All have free tiers.
GEMINI_API_KEY=      # aistudio.google.com/apikey
GROQ_API_KEY=        # console.groq.com/keys
CEREBRAS_API_KEY=    # cloud.cerebras.ai
MISTRAL_API_KEY=     # console.mistral.ai
OPENROUTER_API_KEY=  # openrouter.ai/keys
# Optional local last resort (install Ollama, `ollama pull qwen2.5:7b`):
# USE_OLLAMA=1
# Optional overrides if a provider renames/removes a model:
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_ORDER=groq,gemini,cerebras
